---
interface Props {
  value: string
  label: string
}

const { value, label } = Astro.props
---

<div class="flex flex-col gap-1 border border-line bg-surface px-5 py-4">
  <span class="text-3xl font-semibold tracking-tight tabular-nums md:text-4xl">{value}</span>
  <span class="label-mono text-ink-faint">{label}</span>
</div>
