---
interface Props {
  status: 'active' | 'completed' | 'paused'
}

const { status } = Astro.props

const styles: Record<Props['status'], string> = {
  active: 'text-positive border-positive/40 bg-positive-soft',
  completed: 'text-ink-soft border-line-strong bg-surface',
  paused: 'text-ink-faint border-line bg-paper',
}
const labels: Record<Props['status'], string> = {
  active: 'Active',
  completed: 'Completed',
  paused: 'Paused',
}
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.15em]',
    styles[status],
  ]}
>
  <span
    class:list={['size-1.5 rounded-full', status === 'active' ? 'bg-positive' : 'bg-line-strong']}
    aria-hidden
  ></span>
  {labels[status]}
</span>
