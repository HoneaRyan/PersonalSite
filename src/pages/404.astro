---
import Base from '@/layouts/Base.astro'
import { SITE, url } from '@/lib/site'
---

<Base title={`404 — ${SITE.name}`} description="Page not found.">
  <section class="mx-auto flex max-w-3xl flex-col gap-4 px-5 py-24 md:px-8">
    <p class="label-mono text-accent">404</p>
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="leading-relaxed text-ink-soft">This page doesn't exist — or wandered off the map.</p>
    <a href={url('/')} class="label-mono text-accent transition-colors hover:text-accent-strong">
      ← Back home
    </a>
  </section>
</Base>
