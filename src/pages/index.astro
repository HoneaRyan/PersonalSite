---
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import SectionHeading from '@/components/site/SectionHeading.astro'
import ProjectCard from '@/components/site/ProjectCard.astro'
import MetricTile from '@/components/site/MetricTile.astro'
import { SITE, url } from '@/lib/site'

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
)
const featured = (projects.some((p) => p.data.featured)
  ? projects.filter((p) => p.data.featured)
  : projects
).slice(0, 4)

const posts = await getCollection('posts', ({ data }) => !data.draft)
const external = await getCollection('externalPosts')
const writing = [
  ...posts.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    date: p.data.pubDate,
    href: url(`/writing/${p.id}/`),
    external: false,
    source: '',
  })),
  ...external.map((p) => ({
    title: p.data.title,
    description: p.data.description ?? '',
    date: p.data.pubDate,
    href: p.data.url,
    external: true,
    source: p.data.source,
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3)

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' })

const pillars = [
  {
    index: '01',
    title: 'Data platforms & engineering',
    body: 'End-to-end platforms: disparate sources in, autonomous systems out. Schema rigor, lineage, and pipelines that hold up under audit — proven on federal contracts and global logistics alike.',
  },
  {
    index: '02',
    title: 'Machine learning in production',
    body: 'Models that live in production, not notebooks: hybrid recommendation engines on Databricks Model Serving, NLP over messy real-world data, and the measurement loop that keeps them honest.',
  },
  {
    index: '03',
    title: 'Decision science & evidence',
    body: 'Analysis people can act on and defend: executive-grade data storytelling, statistical evidence rigorous enough for attorneys, and quality-driven process measurement.',
  },
]
---

<Base>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid bg-grid-fade absolute inset-0" aria-hidden></div>
    <div class="relative mx-auto flex max-w-5xl flex-col gap-6 px-5 py-20 md:px-8 md:py-28">
      <p class="label-mono text-accent">{SITE.name} · Senior Data Scientist · Memphis, TN</p>
      <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance md:text-5xl">
        One discipline. Every industry.
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-ink-soft">
        Every industry is pushing data somewhere new. I'm a data scientist interested in where
        the discipline itself is going — the principles that transfer, and the interstitial
        layer where one field's advances become another's head start.
      </p>
      <p class="max-w-2xl leading-relaxed text-ink-soft">
        I've practiced across global logistics, eCommerce recommendation systems, federal relief
        programs, and statistical evidence for the courtroom. On the side: a public-interest
        practice in grants, digital government, and nonprofit data.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href={url('/projects/')}
          class="bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors hover:bg-accent-strong"
        >
          View projects
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="border border-line-strong px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>
      <p class="label-mono pt-4 text-ink-faint">
        Practiced in: Logistics · eCommerce · Government · Consumer R&D · Legal evidence
      </p>
    </div>
  </section>

  <!-- ── Track record (all figures from real delivered work) ─────────── -->
  <section class="border-b border-line bg-surface/60">
    <div class="mx-auto grid max-w-5xl grid-cols-2 gap-3 px-5 py-8 md:grid-cols-4 md:px-8">
      <MetricTile value="$550M+" label="federal relief processed" />
      <MetricTile value="100+" label="dashboards supported" />
      <MetricTile value="1,000+" label="platform users" />
      <MetricTile value="8+" label="years in data science" />
    </div>
  </section>

  <!-- ── What I do ────────────────────────────────────────────────────── -->
  <section class="mx-auto max-w-5xl px-5 py-16 md:px-8">
    <SectionHeading title="What I do" />
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        pillars.map((pillar) => (
          <div class="flex flex-col gap-3 border border-line bg-surface p-5">
            <span class="label-mono text-accent">{pillar.index}</span>
            <h3 class="font-semibold tracking-tight">{pillar.title}</h3>
            <p class="text-sm leading-relaxed text-ink-soft">{pillar.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── Public-interest practice, clearly on the side ────────────────── -->
  <section class="mx-auto max-w-5xl px-5 py-8 md:px-8">
    <div class="flex flex-col gap-3 border border-line bg-accent-soft/40 p-6 md:p-8">
      <span class="label-mono text-accent">On the side</span>
      <h2 class="text-lg font-semibold tracking-tight">Data in the public interest</h2>
      <p class="max-w-3xl text-sm leading-relaxed text-ink-soft md:text-base">
        Where the discipline meets my values: grant-funded data systems, digital government,
        and turning nonprofit program data into the metrics that win public funding. A personal
        practice that happens to align with my current role — and the source of several of the
        case studies below.
      </p>
    </div>
  </section>

  <!-- ── Featured projects ────────────────────────────────────────────── -->
  <section class="mx-auto max-w-5xl px-5 py-8 md:px-8">
    <SectionHeading title="Projects" href={url('/projects/')} />
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- ── Recent writing ───────────────────────────────────────────────── -->
  <section class="mx-auto max-w-5xl px-5 py-8 md:px-8">
    <SectionHeading title="Writing" href={url('/writing/')} />
    {
      writing.length > 0 ? (
        <ul class="mt-2 flex flex-col">
          {writing.map((item) => (
            <li class="border-b border-line last:border-0">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="group flex flex-col gap-1 py-4"
              >
                <span class="label-mono text-ink-faint">
                  {dateFmt.format(item.date)}
                  {item.external && ` · ${item.source} ↗`}
                </span>
                <span class="font-medium transition-colors group-hover:text-accent">
                  {item.title}
                </span>
                {item.description && (
                  <span class="text-sm text-ink-soft">{item.description}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 text-sm text-ink-soft">
          First posts are in the works — on grant-funded data systems, digital government, and
          the metrics that win funding.
        </p>
      )
    }
  </section>
</Base>
