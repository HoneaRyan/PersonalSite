---
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import { SITE, url } from '@/lib/site'

const posts = await getCollection('posts', ({ data }) => !data.draft)
const external = await getCollection('externalPosts')

const items = [
  ...posts.map((p) => ({
    title: p.data.title,
    description: p.data.description,
    date: p.data.pubDate,
    href: url(`/writing/${p.id}/`),
    external: false,
    source: '',
  })),
  ...external.map((p) => ({
    title: p.data.title,
    description: p.data.description ?? '',
    date: p.data.pubDate,
    href: p.data.url,
    external: true,
    source: p.data.source,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime())

const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<Base title={`Writing — ${SITE.name}`} description="Writing on grant-funded data systems, digital government, and nonprofit metrics.">
  <section class="mx-auto max-w-3xl px-5 py-14 md:px-8">
    <p class="label-mono text-accent">Writing</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Notes from the field</h1>
    <p class="mt-3 leading-relaxed text-ink-soft">
      On where data as a discipline is going — and on its public-interest applications:
      grant-funded systems, digital government, nonprofit metrics. Posts published elsewhere
      link out directly, and shorter, more frequent notes land on{' '}
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline underline-offset-4"
      >
        LinkedIn ↗
      </a>
      .
    </p>

    {
      items.length > 0 ? (
        <ul class="mt-10 flex flex-col">
          {items.map((item) => (
            <li class="border-b border-line last:border-0">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="group flex flex-col gap-1 py-5"
              >
                <span class="label-mono text-ink-faint">
                  {dateFmt.format(item.date)}
                  {item.external && ` · ${item.source} ↗`}
                </span>
                <span class="text-lg font-medium transition-colors group-hover:text-accent">
                  {item.title}
                </span>
                {item.description && <span class="text-sm text-ink-soft">{item.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="mt-10 border border-line bg-surface p-6">
          <p class="text-sm leading-relaxed text-ink-soft">
            First posts are in the works. In the meantime, you can reach me at{' '}
            <a href={`mailto:${SITE.email}`} class="text-accent underline underline-offset-4">
              {SITE.email}
            </a>
            .
          </p>
        </div>
      )
    }
  </section>
</Base>
